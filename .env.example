# Фронтенд (попадает в браузер)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Только для скриптов (scripts/seed/seed.cli.ts, `npm run seed`). Никогда не префиксовать VITE_, не коммитить.
# Seed читает переменные только из окружения или из файла, переданного явно: `--env-file <path>`.
# Локально: .env.seed.local (gitignored; значения из `npx supabase status` + SEED_PASSWORD),
# `npm run seed -- --env-file .env.seed.local`. Облачный проект требует флаг `--yes`.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SEED_PASSWORD=

# Тесты БД читают .env.test.local (gitignored): SUPABASE_URL, SUPABASE_ANON_KEY,
# SUPABASE_SERVICE_ROLE_KEY — локальные значения из `npx supabase status`.
