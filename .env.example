# Фронтенд (попадает в браузер)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Только для скриптов (scripts/seed.ts). Никогда не префиксовать VITE_, не коммитить.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SEED_PASSWORD=

# Тесты БД читают .env.test.local (gitignored): SUPABASE_URL, SUPABASE_ANON_KEY,
# SUPABASE_SERVICE_ROLE_KEY — локальные значения из `npx supabase status`.
